# ==========================================
# Игнорирование служебных файлов Visual Studio
# ==========================================

# Скрытые служебные папки настроек IDE
.vs/
.vscode/

# Скомпилированные исполняемые файлы и промежуточные объекты
Debug/
Release/
x64/
x86/
[Bb]in/
[Oo]bj/
*.exe
*.obj
*.o
*.pdb
*.ilk
*.idb

# Базы данных IntelliSense и анализатора кода
*.VC.db
*.VC.opendb
*.VC.db-shm
*.VC.db-wal
*.ipch

# Пользовательские персональные настройки (разрешения окон, точки останова)
*.suo
*.user
*.userosscache
*.sln.docstates

# Логи и отчеты сборки
*.log
*.tlog
*.lastbuildstate
*.Build.CppClean.log

# Временные бэкапы
*.bak
*.tmp
